        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\"nom\":\"Souris {{$timestamp}}\",\"prix\":250,\"description\":\"Souris\",\"categorie\":\"Informatique\",\"statut\":\"DISPONIBLE\"}",
